---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const name = SITE_TITLE;
const title = "Technical Designer | Producer";
import Portrait from '../assets/CloneHelmets.jpg';
import {Image} from "astro:assets";
---
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
<body>
<Header/>
<main class="flex-grow px-4 py-16 max-w-6xl mx-auto">
	<section class="mb-12">
		<h1 class="text-4xl font-semibold mb-2">{name}</h1>
		<p class="text-lg text-gray-700">{title}</p>
	</section>

	<section class="grid gap-8 md:grid-cols-2 items-center">
		<div class="flex justify-center md:justify-start">
			<Image
				src={Portrait}
				alt={`${name} profile`}
				class="w-128 h-128 rounded-xl shadow-lg object-cover"
				width={512}
				height={512}
				loading="eager"
			/>
		</div>

		<div class="text-left">
			<h2 class="text-3xl font-bold mb-2">About Me</h2>
			<p class="text-gray-700">
				I enjoy breaking things, then finding a way to fix them.
				
				I am a Software Developer proficient in C#. A Game Designer who enjoys using tooling and a data-oriented approach, and a Technical Project Manager who likes timelines, deadlines, and attention to detail.
				
				When I am not working on my computer, I am touching grass: Backpacking, camping, hiking, and canoeing, or tending to my numerous houseplants.
				
				Finding me on a hiking trail is difficult, so if you want to reach out to me about the outdoors, or what I do professionally,  the best way is my email at williamcarltallarico@gmail.com or here on LinkedIn.
			</p>

			<a href="/project"
			   class="inline-block mt-4 bg-brand-green text-brand-grey px-6 py-3 rounded-lg shadow hover:bg-green-700 transition">
				View My Projects
			</a>

			<a href="/blog"
			   class="inline-block mt-4 bg-brand-green text-brand-grey px-6 py-3 rounded-lg shadow hover:bg-green-700 transition">
				Check out my Blog
			</a>
		</div>
	</section>
</main>

<Footer/>
</body>
